# =========================================================================
# GIGA DIGITAL AGENCY — ENVIRONMENT CONFIGURATION
# =========================================================================
# Configure these variables in your Vercel Project Settings (Settings -> Environment Variables)

# 1. Receiver Email Address (Mandatory Destination)
CONTACT_RECEIVER_EMAIL=info@gigadigitalagency.com

# 2. Resend API Key (Recommended for 100% Reliable Email Delivery)
# Sign up free at https://resend.com and paste your API key here:
RESEND_API_KEY=re_your_api_key_here

# 3. Sender Email Address (Configured domain in Resend)
EMAIL_FROM="Giga Digital Agency <info@gigadigitalagency.com>"

# 4. Optional SMTP Fallback (If not using Resend)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=info@gigadigitalagency.com
# SMTP_PASS=your_app_specific_password
